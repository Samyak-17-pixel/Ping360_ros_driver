<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ping360_driver</name>
  <version>1.0.0</version>
  <description>Ping360 USB serial driver, recorder services, and web UI assets for ROS 2 Humble. Optional: apt install ros-humble-rosbridge-suite for the browser UI (WebSocket).</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>ping360_msgs</depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosapi</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
